rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function hasPerm(p) {
      return profile().get('permissions', null) == null || p in profile().permissions;
    }
    // نفس منطق الخادم (catalog.ts): التاجر يحتاج «products» والأدمن «stores»
    function canManage(storeId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && profile().status == 'active'
        && ((profile().role == 'admin' && hasPerm('stores'))
            || (profile().role == 'merchant' && profile().storeId == storeId && hasPerm('products')));
    }
    function canManageStores() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && profile().status == 'active'
        && profile().role == 'admin'
        && hasPerm('stores');
    }
    // صاحب الطلب (الزبون) أو إدارة مالية فعّالة
    function activeProfile() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && profile().status == 'active';
    }
    function isOrderCustomer(orderId) {
      return activeProfile()
        && firestore.get(/databases/(default)/documents/orders/$(orderId)).data.customerId == request.auth.uid;
    }
    function isFinanceAdmin() {
      return activeProfile() && profile().role == 'admin' && hasPerm('finance');
    }
    function smallImage() {
      return request.resource.size < 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // صور المنتجات: products/{storeId}/{productId}/{file}
    match /products/{storeId}/{productId}/{file} {
      allow read: if request.auth != null;
      allow create, update: if canManage(storeId) && smallImage();
      allow delete: if canManage(storeId);
    }

    // صور المتاجر: stores/{storeId}/{imageId}/{file} — الرفع من الإدارة فقط
    match /stores/{storeId}/{imageId}/{file} {
      allow read: if request.auth != null;
      allow create, update: if canManageStores() && smallImage();
      allow delete: if canManageStores();
    }

    // إيصالات التحويل: payments/{orderId}/{file} — يرفعها صاحب الطلب، ويقرؤها هو والإدارة المالية فقط
    match /payments/{orderId}/{file} {
      allow read: if isOrderCustomer(orderId) || isFinanceAdmin();
      allow create, update: if isOrderCustomer(orderId) && smallImage();
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
